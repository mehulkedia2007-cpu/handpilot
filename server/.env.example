# Copy this file to server/.env and fill it in. server/.env is gitignored: never commit it.

# Your Anthropic API key, from https://platform.claude.com/ (Settings -> API keys).
# Calls cost money, so set a monthly spending limit in the console first.
ANTHROPIC_API_KEY=

# Which model the agent uses. Required: the code has no built-in default.
AGENT_MODEL=claude-opus-5-5

# Optional: how hard the model thinks (low, medium, high, xhigh, max). Lower is faster
# and cheaper; robot commands are short, so low or medium is usually plenty.
# Leave it empty to use the model's own default.
AGENT_EFFORT=

# If the model declines a request for safety reasons, retry it on a fallback model
# chosen by Anthropic (server-side fallback). Works with Claude Opus 5.5, Opus 5,
# Fable 5.1 and Sonnet 5.5; set it to off for other models.
AGENT_FALLBACK=on

# Port the server listens on (on 127.0.0.1 only).
PORT=8787

# Safety limits: model turns per command, and commands per minute.
MAX_STEPS=6
MAX_REQUESTS_PER_MIN=10

# How long one model call may take before it is abandoned, in milliseconds.
REQUEST_TIMEOUT_MS=30000

# Extra web origins allowed to call the server, comma-separated (localhost and
# the GitHub Pages site are always allowed), e.g. https://example.github.io
ALLOWED_ORIGINS=
